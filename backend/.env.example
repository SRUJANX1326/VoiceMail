PORT=3000
# https://aistudio.google.com/apikey  (free, no card)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Backup models tried if the main one is busy (comma separated)
GEMINI_FALLBACK_MODELS=gemini-flash-latest
# Google Cloud Console -> Credentials -> OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback
# Supabase (free). Leave both empty to store data in backend/data/*.json instead.
# URL: Supabase -> Project Settings -> Data API (https://xxxx.supabase.co)
# KEY: Settings -> API Keys -> SECRET key (sb_secret_...). Never use the publishable/anon key. Never put this key in the frontend.
SUPABASE_URL=
SUPABASE_KEY=

# --- Use a local Ollama model instead of Gemini ---
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama3.2        (any name shown by "ollama list")
# OLLAMA_URL=http://localhost:11434

# --- Use Groq (or any OpenAI-compatible API) instead of Gemini ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=gsk_...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile

# WhatsApp: country code added to 10-digit numbers (91 = India). Change for other countries.
DEFAULT_COUNTRY_CODE=91
